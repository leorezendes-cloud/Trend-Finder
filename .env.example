# Copy these NAME / VALUE settings into your host's Environment settings.
# This file is an example; the app does not automatically load it.
TREND_FINDAH_ENV=production
TREND_FINDAH_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
TREND_FINDAH_DATABASE=/var/data/members.sqlite3
# Set only after verifying the host's trusted reverse-proxy chain.
TREND_FINDAH_PROXY_HOPS=0

# Resend recovery email. Add the real key only to Render, never to Git.
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY
TREND_FINDAH_EMAIL_FROM=Trend Findah <noreply@mail.trendfindah.com>
TREND_FINDAH_PUBLIC_ORIGIN=https://trendfindah.com
